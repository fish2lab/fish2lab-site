{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fish2lab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // 五个页面 host + 制品区的 canonical 主机就在 Cloudflare 面板里绑着，不在配置里声明。
  //
  // 2026-10-11 的教训：那天为了加 sukima.fish2lab.com，在这里只写了一条 routes，
  // deploy 把其余五个 custom domain 当成「不该存在」一并摘掉，fish2lab.com 整站失联。
  // 反过来，配置里没有 routes 时 deploy 只替换 Worker 版本，不动域名绑定。
  // 另外 CI 的 CLOUDFLARE_API_TOKEN 只有 Workers Scripts 权限，声明 routes 会让它报错
  // 停在第 7 步，所以这个列表留在 Dashboard：fish2lab.com、www、portfolio、research、
  // blog、sukima。要改成声明式，先把 token 换成带 Workers Routes:Edit 的。

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "workers_dev": false
}
